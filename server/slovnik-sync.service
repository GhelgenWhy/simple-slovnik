[Unit]
Description=Slovnik sync server
After=network-online.target
Wants=network-online.target

[Service]
User=slovnik-sync
Group=slovnik-sync
WorkingDirectory=/opt/slovnik-sync
EnvironmentFile=/opt/slovnik-sync/.env
ExecStart=/opt/slovnik-sync/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/slovnik-sync/data
UMask=0077

[Install]
WantedBy=multi-user.target
